#!/bin/sh
# Chromium runs inside the cloud task's isolated container. This host has no usable
# setuid/user-namespace Chromium sandbox. Leave TLS and certificate checks enabled.
export XDG_CONFIG_HOME=/workspace/.config
export XDG_CACHE_HOME=/workspace/.cache
export XDG_DATA_HOME=/workspace/.local/share
exec /usr/bin/chromium --no-sandbox --disable-dev-shm-usage "$@"
